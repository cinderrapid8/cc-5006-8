{
  "id": "ex_empty_slot",
  "title": "反例：素材空槽（无占位替换）",
  "pack": "aurora",
  "kind": "negative",
  "desc": "logo 槽位保持未绑定。系统不允许任何占位素材替代，正式渲染前以 ASSET_MISSING 拦截，并带 slotId 定位。",
  "bindings": {
    "background": "bg12.mp4",
    "logo": "logo.png",
    "endcard": "endcard.png"
  },
  "unbind": [
    "logo"
  ],
  "variables": {
    "title": "AURORA LIGHT",
    "tagline": "Feel the glow of a new day"
  },
  "expect": {
    "ok": false,
    "render": false,
    "errors": [
      "ASSET_MISSING"
    ],
    "locatable": true
  },
  "template": {
    "id": "aurora_ad",
    "name": "Aurora — long headline suite template",
    "width": 1280,
    "height": 720,
    "fps": 30,
    "duration": 10,
    "font": {
      "family": "DejaVu Sans",
      "weight": "bold"
    },
    "slots": [
      {
        "id": "background",
        "kind": "video",
        "width": 1280,
        "height": 720,
        "minDuration": 10,
        "match": "exact",
        "required": true
      },
      {
        "id": "logo",
        "kind": "image",
        "width": 320,
        "height": 180,
        "match": "exact",
        "required": true,
        "requiresAlpha": true
      },
      {
        "id": "endcard",
        "kind": "image",
        "width": 1280,
        "height": 720,
        "match": "exact",
        "required": true
      }
    ],
    "variables": [
      {
        "id": "title",
        "type": "text",
        "label": "Headline",
        "maxLength": 200
      },
      {
        "id": "tagline",
        "type": "text",
        "label": "Tagline",
        "maxLength": 120
      }
    ],
    "nodes": [
      {
        "id": "bg",
        "type": "background",
        "inputs": [],
        "params": {
          "slot": "background",
          "opacity": 1
        }
      },
      {
        "id": "logoLayer",
        "type": "logo",
        "inputs": [
          "bg"
        ],
        "params": {
          "slot": "logo",
          "x": 40,
          "y": 36,
          "start": 0.3,
          "end": 7.5,
          "fadeIn": 0.5,
          "fadeOut": 0.5,
          "opacity": 1
        }
      },
      {
        "id": "titleLayer",
        "type": "text",
        "inputs": [
          "logoLayer"
        ],
        "params": {
          "variable": "title",
          "x": 80,
          "y": 250,
          "width": 1120,
          "height": 170,
          "fontSize": 72,
          "color": "#ffd166",
          "start": 0.6,
          "end": 7.8,
          "fadeIn": 0.4,
          "fadeOut": 0.4,
          "align": "center",
          "lineHeight": 1.15
        }
      },
      {
        "id": "taglineLayer",
        "type": "text",
        "inputs": [
          "titleLayer"
        ],
        "params": {
          "variable": "tagline",
          "x": 240,
          "y": 450,
          "width": 800,
          "height": 90,
          "fontSize": 40,
          "color": "#FFFFFF",
          "start": 0.9,
          "end": 7.8,
          "fadeIn": 0.4,
          "fadeOut": 0.4,
          "align": "center",
          "lineHeight": 1.2
        }
      },
      {
        "id": "endcardLayer",
        "type": "endcard",
        "inputs": [
          "taglineLayer"
        ],
        "params": {
          "slot": "endcard",
          "start": 8,
          "fadeIn": 0.6
        }
      },
      {
        "id": "out",
        "type": "output",
        "inputs": [
          "endcardLayer"
        ],
        "params": {}
      }
    ]
  }
}
