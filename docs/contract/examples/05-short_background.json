{
  "id": "ex_short_background",
  "title": "反例：背景素材时长不足",
  "pack": "aurora",
  "kind": "negative",
  "desc": "background 槽位改绑 cobalt 包的 6s 素材 bg6.mp4；槽位 minDuration=10s，独立 ffprobe 实测 6.000s 后报 ASSET_DURATION_SHORT（容差 0.05s）。",
  "bindings": {
    "background": "bg6.mp4",
    "logo": "logo.png",
    "endcard": "endcard.png"
  },
  "unbind": [],
  "variables": {
    "title": "AURORA LIGHT",
    "tagline": "Feel the glow of a new day"
  },
  "expect": {
    "ok": false,
    "render": false,
    "errors": [
      "ASSET_DURATION_SHORT"
    ],
    "locatable": true,
    "messagePattern": "6.000s"
  },
  "template": {
    "id": "aurora_ad",
    "name": "Aurora — long headline suite template",
    "width": 1280,
    "height": 720,
    "fps": 30,
    "duration": 10,
    "font": {
      "family": "DejaVu Sans",
      "weight": "bold"
    },
    "slots": [
      {
        "id": "background",
        "kind": "video",
        "width": 1280,
        "height": 720,
        "minDuration": 10,
        "match": "exact",
        "required": true
      },
      {
        "id": "logo",
        "kind": "image",
        "width": 320,
        "height": 180,
        "match": "exact",
        "required": true,
        "requiresAlpha": true
      },
      {
        "id": "endcard",
        "kind": "image",
        "width": 1280,
        "height": 720,
        "match": "exact",
        "required": true
      }
    ],
    "variables": [
      {
        "id": "title",
        "type": "text",
        "label": "Headline",
        "maxLength": 200
      },
      {
        "id": "tagline",
        "type": "text",
        "label": "Tagline",
        "maxLength": 120
      }
    ],
    "nodes": [
      {
        "id": "bg",
        "type": "background",
        "inputs": [],
        "params": {
          "slot": "background",
          "opacity": 1
        }
      },
      {
        "id": "logoLayer",
        "type": "logo",
        "inputs": [
          "bg"
        ],
        "params": {
          "slot": "logo",
          "x": 40,
          "y": 36,
          "start": 0.3,
          "end": 7.5,
          "fadeIn": 0.5,
          "fadeOut": 0.5,
          "opacity": 1
        }
      },
      {
        "id": "titleLayer",
        "type": "text",
        "inputs": [
          "logoLayer"
        ],
        "params": {
          "variable": "title",
          "x": 80,
          "y": 250,
          "width": 1120,
          "height": 170,
          "fontSize": 72,
          "color": "#ffd166",
          "start": 0.6,
          "end": 7.8,
          "fadeIn": 0.4,
          "fadeOut": 0.4,
          "align": "center",
          "lineHeight": 1.15
        }
      },
      {
        "id": "taglineLayer",
        "type": "text",
        "inputs": [
          "titleLayer"
        ],
        "params": {
          "variable": "tagline",
          "x": 240,
          "y": 450,
          "width": 800,
          "height": 90,
          "fontSize": 40,
          "color": "#FFFFFF",
          "start": 0.9,
          "end": 7.8,
          "fadeIn": 0.4,
          "fadeOut": 0.4,
          "align": "center",
          "lineHeight": 1.2
        }
      },
      {
        "id": "endcardLayer",
        "type": "endcard",
        "inputs": [
          "taglineLayer"
        ],
        "params": {
          "slot": "endcard",
          "start": 8,
          "fadeIn": 0.6
        }
      },
      {
        "id": "out",
        "type": "output",
        "inputs": [
          "endcardLayer"
        ],
        "params": {}
      }
    ]
  },
  "packAssets": {
    "background": {
      "pack": "cobalt",
      "file": "bg6.mp4"
    }
  }
}
